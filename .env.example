# ==========================================================
# BYE QUIZ LIVE - SECURE PRODUCTION ENVIRONMENT CONFIG
# ==========================================================

NODE_ENV=production
PORT=3000
DATABASE_URL=
SESSION_SECRET=
ADMIN_PASSWORD_HASH=

# Optional Euler Stream signing API key. Free community signing works without it;
# set this only if you have an Euler Stream API key.
SIGN_API_KEY=

# TikTok connection timeouts
TIKTOK_CONNECT_TIMEOUT_MS=30000
TIKTOK_CLIENT_TIMEOUT=30000
WS_CONNECT_TIMEOUT_MS=30000

TIKTOK_USERNAME=
ENABLE_SIMULATOR=false
