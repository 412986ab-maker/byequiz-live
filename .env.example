# ==========================================================
# BYE QUIZ LIVE - SECURE PRODUCTION ENVIRONMENT CONFIG
# ==========================================================

# Environment Mode (production / development)
NODE_ENV=production

# Server Port (Default: 3000 or dynamically assigned by host)
PORT=3000

# PostgreSQL Database Connection URL (Production primary database)
# Example: postgres://username:password@localhost:5432/byequiz_db
# When empty, engine automatically operates with resilient in-memory/JSON fallback storage
DATABASE_URL=

# Cryptographic Session & Token Secret (Generate a strong 64-char hex string)
SESSION_SECRET=

# Pre-computed PBKDF2 Password Hash for Super Admin (salt:hash)
# Generated via: lib/auth.js hashPassword('your_secret_password')
ADMIN_PASSWORD_HASH=

# TikTok Host Live Username (Target channel handle without '@')
TIKTOK_USERNAME=your_tiktok_username_here

# Simulator Flag (Set false in official live broadcast production)
ENABLE_SIMULATOR=false
