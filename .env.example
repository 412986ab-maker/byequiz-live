# ==========================================================
# BYE QUIZ LIVE - SECURE PRODUCTION ENVIRONMENT CONFIG
# ==========================================================

NODE_ENV=production
PORT=3000
DATABASE_URL=
SESSION_SECRET=
ADMIN_PASSWORD_HASH=

# Euler Stream API key used by tiktok-live-connector for signing-related traffic.
# Keep the real value in Railway Variables / environment secrets; never commit it.
EULERSTREAM_API_KEY=
# Backward-compatible local/legacy name (optional)
SIGN_API_KEY=

# TikTok connection timeouts
TIKTOK_CONNECT_TIMEOUT_MS=30000
TIKTOK_CLIENT_TIMEOUT=30000
WS_CONNECT_TIMEOUT_MS=30000

TIKTOK_USERNAME=
ENABLE_SIMULATOR=false
